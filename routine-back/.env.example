# Copy to .env and fill in. Never commit real values (.env is in .gitignore).

# PostgreSQL connection (use the app role, not the superuser)
DATABASE_URL="postgresql://routine:CHANGE_ME@localhost:5432/routine?schema=public"

# Separate database used only by integration tests (wiped by the test suite)
TEST_DATABASE_URL="postgresql://routine:CHANGE_ME@localhost:5432/routine_test?schema=public"

# Origin of routine-front. Mutating API requests from any other origin are rejected (CSRF),
# and the links in the e-mails point here.
APP_ORIGIN="http://localhost:5174"

# API port
PORT=3334

# Set to "true" only when running behind a reverse proxy (so the real client IP is used)
TRUST_PROXY="false"

# Server secret, at least 32 characters. It goes into every password hash (pepper) and signs
# the session and e-mail link tokens. Generate your own (one for development, another for production):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Never change it after people have accounts: every password stops working.
AUTH_SECRET="CHANGE_ME"

# "false" closes the public sign-up page (accounts only through npm run user:create)
SIGNUP_ENABLED="true"

# E-mails (confirm account, forgot password, change e-mail):
#   console = printed in this terminal, nothing is sent (development)
#   gmail   = sent from your Gmail account (GMAIL_USER + GMAIL_APP_PASSWORD)
#   resend  = sent through resend.com (needs RESEND_API_KEY and a sender from a verified domain)
# Check the setup with: npm run mail:test -- your-email@gmail.com
MAIL_PROVIDER="console"

# Gmail: the address, and an app password created at https://myaccount.google.com/apppasswords
# (needs 2-step verification on; it is NOT your Gmail password)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

RESEND_API_KEY=""

# Sender shown in the e-mails. Empty = "Routine <GMAIL_USER>" with Gmail.
MAIL_FROM=""
