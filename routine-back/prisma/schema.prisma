// Routine — PostgreSQL schema
//
// Conventions (see docs/ARCHITECTURE.md):
// - Every user-owned table has `user_id` and a composite unique (id, user_id).
//   Child tables reference parents through (parent_id, user_id) so the database
//   itself rejects cross-user references, not only the service layer.
// - Civil dates (a day of the routine) use `date`; instants use `timestamptz`.
//   Civil dates are interpreted in America/Sao_Paulo.
// - Times of day are minutes since 00:00 (Int, 0–1440).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Auth ─────────────────────────────

enum UserRole {
  ADMIN
  USER
}

model User {
  id                    String    @id @default(uuid(7)) @db.Uuid
  email                 String    @unique // always stored lower-cased
  name                  String
  passwordHash          String    @map("password_hash")
  role                  UserRole  @default(USER)
  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz(3)
  /// Set when the user opens the confirmation link (or resets the password by e-mail).
  /// Login is refused while null.
  emailVerifiedAt       DateTime? @map("email_verified_at") @db.Timestamptz(3)
  /// Set when an admin lets a public sign-up in (accounts created by the
  /// `user:create` script start approved). Login is refused while null.
  approvedAt            DateTime? @map("approved_at") @db.Timestamptz(3)
  /// Only on demonstration accounts (one per visitor, fictional data): when
  /// it stops working and is deleted. Null on every real account.
  demoExpiresAt         DateTime? @map("demo_expires_at") @db.Timestamptz(3)
  /// Two-step verification (authenticator app, TOTP). The secret is stored
  /// encrypted (AES-256-GCM, key derived from AUTH_SECRET); it is set while
  /// the user sets it up, and 2FA is on only once `twoFactorEnabledAt` is set.
  twoFactorSecret       String?   @map("two_factor_secret")
  twoFactorEnabledAt    DateTime? @map("two_factor_enabled_at") @db.Timestamptz(3)
  /// Last 30-second step whose code was accepted: each code works only once.
  twoFactorLastStep     Int?      @map("two_factor_last_step")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions      Session[]
  authTokens    AuthToken[]
  recoveryCodes RecoveryCode[]
  settings      UserSettings?
  auditLogs     AuditLog[]
  categories    Category[]
  routineRules  RoutineRule[]
  dayItems      DayItem[]
  dayItemSteps  DayItemStep[]
  dayModes      DayMode[]
  waterLogs     WaterLog[]
  telegram      TelegramLink?
  simulations   Simulation[]
  specialDays   SpecialDay[]
  telegramDrafts TelegramDraft[]
  personalGoals PersonalGoal[]

  @@index([demoExpiresAt])
  @@map("users")
}

/// Server-side session. `id` is the HMAC-SHA256 (hex, keyed by AUTH_SECRET) of
/// the random token stored in the HttpOnly cookie; the raw token is never persisted.
model Session {
  id         String   @id
  userId     String   @map("user_id") @db.Uuid
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  userAgent  String?  @map("user_agent")
  ipAddress  String?  @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum AuthTokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  EMAIL_CHANGE
  /// Password accepted, waiting for the authenticator code (never e-mailed).
  TWO_FACTOR_LOGIN
  /// One-time t.me link that ties a Telegram chat to the user (stage 7).
  TELEGRAM_LINK
}

/// One-time recovery codes for two-step verification (when the phone is
/// lost). `id` is the HMAC of the code; the code itself is shown only once.
model RecoveryCode {
  id        String   @id
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

/// Requests per client per minute, for the API-wide limit. One row per
/// bucket ("ip:1.2.3.4") and minute; old rows are deleted now and then.
model RequestCounter {
  bucket      String
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int      @default(0)

  @@id([bucket, windowStart])
  @@index([windowStart])
  @@map("request_counters")
}

/// One-time tokens sent by e-mail (confirm account, reset password, confirm a
/// new e-mail). `id` is the HMAC of the token in the link; the raw token is
/// never stored. Deleted when used, replaced when a new one is asked for.
model AuthToken {
  id        String           @id
  userId    String           @map("user_id") @db.Uuid
  purpose   AuthTokenPurpose
  /// EMAIL_CHANGE only: the address being confirmed.
  newEmail  String?          @map("new_email")
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("auth_tokens")
}

/// Login attempts, used for rate limiting (per e-mail and per IP). Other
/// limited actions (sign-up, e-mails) use it too, with a prefixed identifier
/// such as "register-ip:1.2.3.4" and no ip_address.
model LoginAttempt {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String // lower-cased e-mail as typed
  ipAddress  String?  @map("ip_address")
  success    Boolean
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([identifier, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

// ─────────────────────────── Settings ───────────────────────────

model UserSettings {
  userId    String   @id @map("user_id") @db.Uuid
  locale    String   @default("pt-BR")
  /// "Today" and the routine's hours are read in this time zone.
  timezone  String   @default("America/Sao_Paulo")
  /// Office weekdays over time, oldest first: [{ from: "YYYY-MM-DD", weekdays:
  /// [2, 4] }] (0 = Sunday … 6 = Saturday). A change applies from a day on, so
  /// past days keep theirs. Other days are home days; one day can be switched
  /// ("Hoje é home"): see DayMode.
  officeDays     Json     @default("[]") @map("office_days")
  /// Workouts offered when a workout is marked done (free text, editable).
  workoutTypes   String[] @default(["Corrida", "Muay thai", "Academia"]) @map("workout_types")
  /// Water goal of a day, in ml (stage 4).
  waterGoalMl    Int      @default(2000) @map("water_goal_ml")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ───────────────────────────── Routine ─────────────────────────────

/// What an item is. HABIT (stage 3) and CLASS (stage 4) exist already so the
/// enum never needs a migration of its own later.
enum ItemKind {
  ROUTINE
  APPOINTMENT
  WORKOUT
  TASK
  HABIT
  CLASS
}

/// A part of the day, for items without an exact time ("sábado de manhã").
/// Morning 06–12, afternoon 12–18, evening 18–24 (utils/routineUtils.PERIODS).
enum DayPeriod {
  MORNING
  AFTERNOON
  EVENING
}

/// Office or home day. On a rule: the item only happens on that kind of day.
enum WorkMode {
  OFFICE
  HOME
}

enum DayItemStatus {
  PENDING
  DONE
  /// "Não houve": kept so it is not created again, and it does not count as a miss.
  SKIPPED
}

/// Color and icon of items. `colorKey` names one of the --cat-* tints of the
/// front (never a hex). Used categories are archived, not deleted.
model Category {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  name       String
  colorKey   String   @map("color_key")
  icon       String
  sortOrder  Int      @default(0) @map("sort_order")
  isArchived Boolean  @default(false) @map("is_archived")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rules    RoutineRule[]
  dayItems DayItem[]

  @@unique([id, userId])
  @@index([userId])
  @@map("categories")
}

/// A fixed item: repeats on the chosen weekdays from `startDate` until
/// `endDate` (inclusive, open when null). "Daqui pra frente" closes a rule and
/// starts a new one, so past days never change.
model RoutineRule {
  id             String    @id @default(uuid(7)) @db.Uuid
  seriesId       String    @default(uuid(7)) @map("series_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  categoryId     String?   @map("category_id") @db.Uuid
  kind           ItemKind
  name           String
  /// 0 = Sunday … 6 = Saturday, sorted, no repeats.
  weekdays       Int[]
  /// Minutes since 00:00; both null = no time ("a qualquer hora").
  startMinute    Int?      @map("start_minute")
  endMinute      Int?      @map("end_minute")
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  /// A part of the day instead of exact times (never both).
  period         DayPeriod?
  /// Null = every day; OFFICE / HOME = only on office / home days.
  mode           WorkMode?
  /// Planned workout ("Muay thai"); null = chosen when marked done. WORKOUT only.
  variant        String?
  /// Icon of the item (lucide kebab-case name); null = the category's icon.
  icon           String?
  /// Checklist of a routine block ("afazeres"), copied to each day:
  /// [{ key: uuid, name }]. The key stays the same across "daqui pra frente"
  /// versions, so a step keeps its streak. ROUTINE only; [] otherwise.
  steps          Json      @default("[]")
  /// A list ("Rotina diária", "Rotina do trabalho"): its steps also show inside the blocks of these
  /// rules on the same day (Condução, Almoço…). Checking them there checks this item's steps.
  insideRuleIds  String[]  @default([]) @map("inside_rule_ids") @db.Uuid
  /// Skipped on holidays, vacation and days off (stage 5).
  skipOnHolidays Boolean   @default(false) @map("skip_on_holidays")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)
  dayItems DayItem[]

  @@unique([id, userId])
  @@index([userId, startDate])
  @@index([userId, seriesId])
  @@map("routine_rules")
}

/// What exists on a day: made from a rule the first time the day is opened
/// (`ruleId` + `originDate`), or added just for that day (no rule: a task, an
/// appointment). `date` is where the item is now (rescheduling changes it);
/// `originDate` is the rule's day, so a moved or skipped item is never made again.
model DayItem {
  id           String        @id @default(uuid(7)) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  ruleId       String?       @map("rule_id") @db.Uuid
  seriesId     String?       @map("series_id") @db.Uuid
  categoryId   String?       @map("category_id") @db.Uuid
  kind         ItemKind
  name         String
  /// Null only for a one-off task without a date ("A fazer").
  date         DateTime?     @db.Date
  originDate   DateTime?     @map("origin_date") @db.Date
  startMinute  Int?          @map("start_minute")
  endMinute    Int?          @map("end_minute")
  period       DayPeriod?
  /// Workout done (or planned): "Corrida", "Muay thai"… WORKOUT only.
  variant      String?
  /// Copied from the rule, or chosen for a one-off item; null = the category's icon.
  icon         String?
  status       DayItemStatus @default(PENDING)
  doneAt       DateTime?     @map("done_at") @db.Timestamptz(3)
  /// When it was really done, in minutes since 00:00 of its day ("fiz em
  /// outro horário"); null when unknown (marked on a later day).
  doneMinute   Int?          @map("done_minute")
  reviewedAt   DateTime?     @map("reviewed_at") @db.Timestamptz(3)
  scheduledDate DateTime?    @map("scheduled_date") @db.Date
  scheduledMinute Int?       @map("scheduled_minute")
  skipReason   String?       @map("skip_reason")
  /// Imprevisto: something that happened outside the plan (freela, trânsito,
  /// cano estourado). Always one-off, with a time; does not count in the score.
  isUnplanned  Boolean       @default(false) @map("is_unplanned")
  /// The imprevisto that took this item's time. It still counts in the score;
  /// the reports show why.
  displacedById String?      @map("displaced_by_id") @db.Uuid
  /// Changed "só hoje" (or rescheduled): no longer follows its rule.
  isOverridden Boolean       @default(false) @map("is_overridden")
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule     RoutineRule? @relation(fields: [ruleId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)
  category Category?    @relation(fields: [categoryId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)
  steps    DayItemStep[]

  @@unique([id, userId])
  @@unique([ruleId, originDate])
  @@index([userId, date])
  @@index([userId, status, date])
  @@index([userId, scheduledDate])
  @@map("day_items")
}

model PersonalGoal {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  name       String
  subject    String
  targetKey  String?  @map("target_key") @db.Uuid
  targetName String?  @map("target_name")
  unit       String
  amount     Int
  period     String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, userId])
  @@index([userId])
  @@map("personal_goals")
}

/// One step of a routine block on a day (copied from the rule's `steps`).
/// Done = `doneAt` set. "Não houve" is for the whole block (its DayItem).
model DayItemStep {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  dayItemId String    @map("day_item_id") @db.Uuid
  /// The step's key in the rule (same across versions): streaks follow it.
  stepKey   String    @map("step_key") @db.Uuid
  name      String
  /// Optional time inside the block (minutes since 00:00), e.g. "Reunião 15:00" inside Trabalho.
  minute    Int?
  sortOrder Int       @map("sort_order")
  doneAt    DateTime? @map("done_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayItem DayItem @relation(fields: [dayItemId, userId], references: [id, userId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([id, userId])
  @@unique([dayItemId, stepKey])
  @@index([userId, stepKey])
  @@map("day_item_steps")
}

/// A day switched from its default ("Hoje é home"). Days without a row
/// follow UserSettings.officeWeekdays.
model DayMode {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  date      DateTime @db.Date
  mode      WorkMode
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("day_modes")
}

// ───────────────────────────── System ─────────────────────────────

/// Append-only trail of sensitive changes (deletions, auth, security).
/// Never store passwords or tokens in `metadata`.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// One time water was drunk ("bebi 300"): the amount and when. The day is the
/// civil date in the user's time zone, so a log after midnight counts on the new day.
model WaterLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  date      DateTime @db.Date
  amountMl  Int      @map("amount_ml")
  loggedAt  DateTime @default(now()) @map("logged_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, userId])
  @@index([userId, date])
  @@map("water_logs")
}

/// The user's Telegram chat (stage 7): one chat per user and one user per chat.
model TelegramLink {
  userId   String   @id @map("user_id") @db.Uuid
  chatId   BigInt   @unique @map("chat_id")
  /// Telegram @username when it has one (shown in Configurações).
  username String?
  linkedAt DateTime @default(now()) @map("linked_at") @db.Timestamptz(3)
  /// Day the morning summary was last sent (once a day, at the Acordar time).
  morningSentOn DateTime? @map("morning_sent_on") @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_links")
}

/// What the bot understood and waits for "Salvar" or "Cancelar" (stage 7B).
/// The buttons carry only the id; old drafts are cleaned on each new one.
model TelegramDraft {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  payload   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("telegram_drafts")
}

/// A draft weekly routine to play with (Simulações): blocks as JSON, no dates,
/// never touches the days or reports until applied. See SimulationService.
model Simulation {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  blocks    Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("simulations")
}

/// Feriado, férias or doente (stage 5).
enum SpecialKind {
  HOLIDAY
  VACATION
  SICK
}

/// A special day or period (from…to, both included). Fixed items with
/// skipOnHolidays do not happen on these days. See SpecialDayService.
model SpecialDay {
  id        String      @id @default(uuid(7)) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  kind      SpecialKind
  fromDate  DateTime    @map("from_date") @db.Date
  toDate    DateTime    @map("to_date") @db.Date
  name      String?
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, fromDate])
  @@map("special_days")
}
